<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<DialogPane fx:id="dialogPane" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.TargetDialogController">
    <headerText>
        ターゲットの新規作成
    </headerText>
    <content>
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            
            <Label text="名前:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            
            <Label text="X座標 [m]:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="xField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label text="Y座標 [m]:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="yField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            
            <Label text="Z座標 [m]:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="zField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            
            <Label text="方向 X:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="dirXField" text="1.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            
            <Label text="方向 Y:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <TextField fx:id="dirYField" text="0.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            
            <Label text="方向 Z:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
            <TextField fx:id="dirZField" text="0.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
        </GridPane>
    </content>
    <buttonTypes>
        <ButtonType text="作成" buttonData="OK_DONE" />
        <ButtonType text="キャンセル" buttonData="CANCEL_CLOSE" />
    </buttonTypes>
</DialogPane>
